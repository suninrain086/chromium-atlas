{
  "name": "chromium-atlas",
  "private": true,
  "version": "1.0.1-alpha.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "scan": "tsx scripts/scan-docs.ts",
    "sync:real": "node scripts/sync-chromium.mjs && tsx scripts/scan-docs.ts --source real",
    "test:build": "DOCS_DIR=test/fixtures/docs BASE_PATH=/ npm run build",
    "test": "npm run test:build && playwright test",
    "test:ui": "playwright test --ui",
    "check:budget": "node scripts/check-budget.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "cytoscape": "^3.33.2",
    "dompurify": "^3.2.3",
    "fuse.js": "^7.0.0",
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0",
    "vite-plugin-pwa": "^1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
